# MLflow (used by all services)
MLFLOW_TRACKING_URI=http://mlflow:5000

# Inference (where to find the production model)
MODEL_CHECKPOINT_DIR=/app/models/production

# === OPTIONAL: Only needed when using API data pull (not for local demo) ===
# XIAOMI_SUPERTOKEN=your_supertoken_here
# XIAOMI_TOKEN=your_token_here
# USER_IDS=1113363497,3089520729
# PULL_FROM_DATE=2025-01-01
# PULL_TO_DATE=2025-01-31

# === OPTIONAL: Grafana email alerts ===
# Enable SMTP and set your credentials to receive email alerts when MAE > 30.
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.gmail.com:587
# GF_SMTP_USER=your_email@gmail.com
# GF_SMTP_PASSWORD=your_app_password
# GF_SMTP_FROM_ADDRESS=your_email@gmail.com
# GF_ALERT_EMAIL=recipient@example.com
